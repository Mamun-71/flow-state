# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
APP_TIMEZONE=Asia/Dhaka

# Server-only. Lets the super admin create users. Supabase → Project Settings → API Keys → Secret key (sb_secret_...).
# Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=sb_secret_...
